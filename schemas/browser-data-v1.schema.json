{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmprakashSahani/lerobot-state-atlas/schemas/browser-data-v1.schema.json",
  "title": "LeRobot State Atlas browser data v1.2",
  "description": "Structural schema for manifest, coverage, optional trajectory, and optional episode-video documents. Cross-file checksums, CSR consistency, aggregate totals, ordering, media integrity, and path safety are enforced by validate-browser-data.",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/coveragePayload" },
    { "$ref": "#/$defs/trajectoryPayload" },
    { "$ref": "#/$defs/episodeVideoPayload" }
  ],
  "$defs": {
    "schemaVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "major", "minor"],
      "properties": {
        "name": { "const": "lerobot-state-atlas.browser-data" },
        "major": { "const": 1 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    },
    "integerVector3": {
      "type": "array",
      "prefixItems": [
        { "type": "integer" },
        { "type": "integer" },
        { "type": "integer" }
      ],
      "items": false
    },
    "quaternionXyzw": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    },
    "trajectoryState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation", "gripper"],
      "properties": {
        "orientation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "representation",
            "componentOrder",
            "frame",
            "samplePolicy"
          ],
          "properties": {
            "available": { "type": "boolean" },
            "representation": { "const": "unit-quaternion" },
            "componentOrder": {
              "const": ["x", "y", "z", "w"]
            },
            "frame": { "const": "canonical-shared-world" },
            "samplePolicy": { "const": "recorded-sample" }
          }
        },
        "gripper": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "leftSourceComponent",
            "rightSourceComponent",
            "valueSemantics",
            "physicalJawWidthCalibrated",
            "polarityEstablished",
            "visualizationGeometryCalibrated"
          ],
          "properties": {
            "available": { "type": "boolean" },
            "leftSourceComponent": { "const": "left_gripper.pos" },
            "rightSourceComponent": { "const": "right_gripper.pos" },
            "valueSemantics": { "const": "raw-device-specific-unproven" },
            "physicalJawWidthCalibrated": { "const": false },
            "polarityEstablished": { "const": false },
            "visualizationGeometryCalibrated": { "const": false }
          }
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translationXyz", "rotationRpy"],
      "properties": {
        "translationXyz": { "$ref": "#/$defs/vector3" },
        "rotationRpy": { "$ref": "#/$defs/vector3" }
      }
    },
    "payloadReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "filename",
        "required",
        "encoding",
        "byteSize",
        "sha256"
      ],
      "properties": {
        "kind": { "enum": ["coverage", "trajectories", "episode-videos"] },
        "filename": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "encoding": { "const": "json" },
        "byteSize": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "bundleId",
        "exporter",
        "dataset",
        "robot",
        "coverage",
        "coordinates",
        "totals",
        "sceneBounds",
        "payloads"
      ],
      "properties": {
        "schema": { "$ref": "#/$defs/schemaVersion" },
        "bundleId": { "type": "string", "minLength": 1 },
        "exporter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packageVersion",
            "repositoryHeadCommit",
            "workingTreeDirty",
            "sourceDescription",
            "determinism"
          ],
          "properties": {
            "packageVersion": { "type": "string", "minLength": 1 },
            "repositoryHeadCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "workingTreeDirty": { "type": "boolean" },
            "sourceDescription": { "type": "string", "minLength": 1 },
            "determinism": { "type": "string", "minLength": 1 }
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryId",
            "requestedRevision",
            "resolvedRevision",
            "lerobotCodebaseVersion",
            "lerobotPackageVersion",
            "robotType",
            "fps",
            "episodeIds",
            "episodeCount",
            "datasetFrameCount"
          ],
          "properties": {
            "repositoryId": { "type": "string", "minLength": 1 },
            "requestedRevision": { "type": "string", "minLength": 1 },
            "resolvedRevision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "lerobotCodebaseVersion": { "type": "string", "minLength": 1 },
            "lerobotPackageVersion": { "type": "string", "minLength": 1 },
            "robotType": { "type": ["string", "null"] },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "episodeIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 0 }
            },
            "episodeCount": { "type": "integer", "minimum": 1 },
            "datasetFrameCount": { "type": "integer", "minimum": 1 }
          }
        },
        "robot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelName",
            "rootLink",
            "toolLinks",
            "urdfSha256",
            "urdfUpstreamIdentity"
          ],
          "properties": {
            "modelName": { "type": "string", "minLength": 1 },
            "rootLink": { "type": "string", "minLength": 1 },
            "toolLinks": {
              "type": "object",
              "additionalProperties": false,
              "required": ["left", "right"],
              "properties": {
                "left": { "type": "string", "minLength": 1 },
                "right": { "type": "string", "minLength": 1 }
              }
            },
            "urdfSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "urdfUpstreamIdentity": { "type": "string", "minLength": 1 }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voxelSize",
            "voxelOrigin",
            "canonicalTransforms",
            "armSpacing",
            "spacingCalibrated",
            "spacingDisclosure"
          ],
          "properties": {
            "voxelSize": { "type": "number", "exclusiveMinimum": 0 },
            "voxelOrigin": { "$ref": "#/$defs/vector3" },
            "canonicalTransforms": {
              "type": "object",
              "additionalProperties": false,
              "required": ["left", "right"],
              "properties": {
                "left": { "$ref": "#/$defs/transform" },
                "right": { "$ref": "#/$defs/transform" }
              }
            },
            "armSpacing": { "type": "number", "exclusiveMinimum": 0 },
            "spacingCalibrated": { "const": false },
            "spacingDisclosure": { "type": "string", "minLength": 1 }
          }
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lengthUnit",
            "angleUnit",
            "handedness",
            "positionFrame",
            "voxelIndexFormula",
            "rotationConvention",
            "pointTransform"
          ],
          "properties": {
            "lengthUnit": { "const": "metre" },
            "angleUnit": { "const": "radian" },
            "handedness": { "const": "right-handed" },
            "positionFrame": { "const": "canonical-shared-world" },
            "voxelIndexFormula": { "type": "string", "minLength": 1 },
            "rotationConvention": { "type": "string", "minLength": 1 },
            "pointTransform": { "type": "string", "minLength": 1 }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "datasetFrameCount",
            "toolPointVisitCount",
            "armVoxelEntryCount",
            "uniqueSharedGridCellCount"
          ],
          "properties": {
            "datasetFrameCount": { "type": "integer", "minimum": 1 },
            "toolPointVisitCount": { "type": "integer", "minimum": 1 },
            "armVoxelEntryCount": { "type": "integer", "minimum": 1 },
            "uniqueSharedGridCellCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "sceneBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumXyz", "maximumXyz"],
          "properties": {
            "minimumXyz": { "$ref": "#/$defs/vector3" },
            "maximumXyz": { "$ref": "#/$defs/vector3" }
          }
        },
        "payloads": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/payloadReference" }
        },
        "trajectoryState": { "$ref": "#/$defs/trajectoryState" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema": {
                "properties": { "minor": { "maximum": 1 } }
              }
            }
          },
          "then": { "not": { "required": ["trajectoryState"] } }
        },
        {
          "if": {
            "properties": {
              "schema": {
                "properties": { "minor": { "const": 2 } }
              }
            }
          },
          "then": {
            "if": {
              "properties": {
                "payloads": {
                  "contains": {
                    "properties": { "kind": { "const": "trajectories" } },
                    "required": ["kind"]
                  }
                }
              }
            },
            "then": { "required": ["trajectoryState"] },
            "else": { "not": { "required": ["trajectoryState"] } }
          }
        }
      ]
    },
    "coverageArm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "toolLink",
        "voxelIndices",
        "visitCounts",
        "episodeCounts",
        "episodeIdOffsets",
        "episodeIds",
        "statistics"
      ],
      "properties": {
        "arm": { "enum": ["left", "right"] },
        "toolLink": { "type": "string", "minLength": 1 },
        "voxelIndices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/integerVector3" }
        },
        "visitCounts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "episodeCounts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "episodeIdOffsets": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        },
        "episodeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voxelEntryCount",
            "minimumVisitCount",
            "maximumVisitCount",
            "minimumEpisodeCount",
            "maximumEpisodeCount"
          ],
          "properties": {
            "voxelEntryCount": { "type": "integer", "minimum": 1 },
            "minimumVisitCount": { "type": "integer", "minimum": 1 },
            "maximumVisitCount": { "type": "integer", "minimum": 1 },
            "minimumEpisodeCount": { "type": "integer", "minimum": 1 },
            "maximumEpisodeCount": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "coveragePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "arms"],
      "properties": {
        "schema": { "$ref": "#/$defs/schemaVersion" },
        "arms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/coverageArm" }
        }
      }
    },
    "trajectoryEpisodeLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episodeId",
        "frameIndices",
        "timestampsSeconds",
        "leftPositionsXyz",
        "rightPositionsXyz"
      ],
      "properties": {
        "episodeId": { "type": "integer", "minimum": 0 },
        "frameIndices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "timestampsSeconds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        },
        "leftPositionsXyz": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/vector3" }
        },
        "rightPositionsXyz": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/vector3" }
        }
      }
    },
    "trajectoryEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episodeId",
        "frameIndices",
        "timestampsSeconds",
        "leftPositionsXyz",
        "rightPositionsXyz"
      ],
      "properties": {
        "episodeId": { "type": "integer", "minimum": 0 },
        "frameIndices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "timestampsSeconds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        },
        "leftPositionsXyz": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/vector3" }
        },
        "rightPositionsXyz": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/vector3" }
        },
        "leftOrientationsXyzw": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/quaternionXyzw" }
        },
        "rightOrientationsXyzw": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/quaternionXyzw" }
        },
        "leftRecordedGripperValues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        },
        "rightRecordedGripperValues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        }
      },
      "dependentRequired": {
        "leftOrientationsXyzw": ["rightOrientationsXyzw"],
        "rightOrientationsXyzw": ["leftOrientationsXyzw"],
        "leftRecordedGripperValues": ["rightRecordedGripperValues"],
        "rightRecordedGripperValues": ["leftRecordedGripperValues"]
      }
    },
    "trajectoryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "episodes"],
      "properties": {
        "schema": { "$ref": "#/$defs/schemaVersion" },
        "episodes": {
          "type": "array",
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema": {
                "properties": { "minor": { "maximum": 1 } }
              }
            }
          },
          "then": {
            "properties": {
              "episodes": {
                "items": { "$ref": "#/$defs/trajectoryEpisodeLegacy" }
              }
            }
          },
          "else": {
            "properties": {
              "episodes": {
                "items": { "$ref": "#/$defs/trajectoryEpisode" }
              }
            }
          }
        }
      ]
    },
    "episodeVideoCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cameraId", "datasetFeature", "label", "width", "height"],
      "properties": {
        "cameraId": { "type": "string", "minLength": 1 },
        "datasetFeature": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "episodeVideoSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cameraId",
        "filename",
        "mimeType",
        "fromTimestampSeconds",
        "toTimestampSeconds",
        "byteSize",
        "sha256"
      ],
      "properties": {
        "cameraId": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "mimeType": { "const": "video/mp4" },
        "fromTimestampSeconds": { "type": "number", "minimum": 0 },
        "toTimestampSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "byteSize": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "episodeVideoEpisode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodeId", "videos"],
      "properties": {
        "episodeId": { "type": "integer", "minimum": 0 },
        "videos": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/episodeVideoSource" }
        }
      }
    },
    "episodeVideoPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "defaultCameraId", "cameras", "episodes"],
      "properties": {
        "schema": { "$ref": "#/$defs/schemaVersion" },
        "defaultCameraId": { "type": "string", "minLength": 1 },
        "cameras": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/episodeVideoCamera" }
        },
        "episodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/episodeVideoEpisode" }
        }
      }
    }
  }
}
