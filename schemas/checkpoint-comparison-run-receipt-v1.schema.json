{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lerobot-state-atlas.local/schemas/checkpoint-comparison-run-receipt-v1.schema.json",
  "title": "LeRobot State Atlas checkpoint-comparison run receipt v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runnerManifestSha256", "software", "runtime", "dataset", "observation", "cameras", "checkpoints", "modelConfiguration", "processors", "tokenizer", "comparison", "projection", "artifact"],
  "properties": {
    "schema": {"type": "object", "additionalProperties": false, "required": ["name", "major", "minor"], "properties": {"name": {"const": "lerobot-state-atlas.checkpoint-comparison-run-receipt"}, "major": {"type": "integer", "const": 1}, "minor": {"type": "integer", "const": 0}}},
    "runnerManifestSha256": {"$ref": "#/$defs/sha256"},
    "software": {"type": "object", "additionalProperties": false, "required": ["projectVersion", "sourceIdentity", "pythonVersion", "lerobotVersion", "torchVersion", "safetensorsVersion", "pillowVersion", "transformersVersion"], "properties": {"projectVersion": {"$ref": "#/$defs/text"}, "sourceIdentity": {"$ref": "#/$defs/text"}, "pythonVersion": {"$ref": "#/$defs/text"}, "lerobotVersion": {"$ref": "#/$defs/text"}, "torchVersion": {"$ref": "#/$defs/text"}, "safetensorsVersion": {"$ref": "#/$defs/text"}, "pillowVersion": {"$ref": "#/$defs/text"}, "transformersVersion": {"$ref": "#/$defs/text"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["device", "modelDtype", "noiseDtype", "cudaRuntime", "cudaDriver", "gpuName", "computeCapability", "deterministicSettings"], "properties": {"device": {"type": "string", "pattern": "^cuda:[0-9]+$"}, "modelDtype": {"enum": ["bfloat16", "float32"]}, "noiseDtype": {"const": "float32"}, "cudaRuntime": {"$ref": "#/$defs/text"}, "cudaDriver": {"$ref": "#/$defs/text"}, "gpuName": {"$ref": "#/$defs/text"}, "computeCapability": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "items": false}, "deterministicSettings": {"type": "object", "additionalProperties": false, "required": ["cublasWorkspaceConfig", "deterministicAlgorithms", "cudnnDeterministic", "cudnnBenchmark", "cudaMatmulAllowTf32", "cudnnAllowTf32", "float32MatmulPrecision"], "properties": {"cublasWorkspaceConfig": {"const": ":4096:8"}, "deterministicAlgorithms": {"const": true}, "cudnnDeterministic": {"const": true}, "cudnnBenchmark": {"const": false}, "cudaMatmulAllowTf32": {"const": false}, "cudnnAllowTf32": {"const": false}, "float32MatmulPrecision": {"const": "highest"}}}}},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["repositoryId", "revision"], "properties": {"repositoryId": {"$ref": "#/$defs/text"}, "revision": {"$ref": "#/$defs/revision"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["manifestSha256", "manifestByteCount", "observationId"], "properties": {"manifestSha256": {"$ref": "#/$defs/sha256"}, "manifestByteCount": {"type": "integer", "minimum": 1}, "observationId": {"$ref": "#/$defs/text"}}},
    "cameras": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["featureName", "relativePath", "byteCount", "sha256"], "properties": {"featureName": {"enum": ["observation.images.left_wrist", "observation.images.right_wrist", "observation.images.top"]}, "relativePath": {"$ref": "#/$defs/text"}, "byteCount": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "checkpoints": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["policyId", "repositoryId", "revision", "byteCount", "sha256"], "properties": {"policyId": {"enum": ["base-pi05", "fine-tuned-pi05"]}, "repositoryId": {"$ref": "#/$defs/text"}, "revision": {"$ref": "#/$defs/revision"}, "byteCount": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "modelConfiguration": {"type": "object", "additionalProperties": false, "required": ["sourceSha256", "effectiveSha256", "transformations"], "properties": {"sourceSha256": {"$ref": "#/$defs/sha256"}, "effectiveSha256": {"$ref": "#/$defs/sha256"}, "transformations": {"type": "array", "items": {"type": "string"}}}},
    "processors": {"type": "object", "additionalProperties": false, "required": ["sourcePreprocessorSha256", "effectivePreprocessorSha256", "preprocessorStateSha256", "sourcePostprocessorSha256", "effectivePostprocessorSha256", "postprocessorStateSha256", "sharedForPolicyIds"], "properties": {"sourcePreprocessorSha256": {"$ref": "#/$defs/sha256"}, "effectivePreprocessorSha256": {"$ref": "#/$defs/sha256"}, "preprocessorStateSha256": {"$ref": "#/$defs/sha256"}, "sourcePostprocessorSha256": {"$ref": "#/$defs/sha256"}, "effectivePostprocessorSha256": {"$ref": "#/$defs/sha256"}, "postprocessorStateSha256": {"$ref": "#/$defs/sha256"}, "sharedForPolicyIds": {"const": ["base-pi05", "fine-tuned-pi05"]}}},
    "tokenizer": {"type": "object", "additionalProperties": false, "required": ["repositoryId", "directoryIdentitySha256"], "properties": {"repositoryId": {"const": "google/paligemma-3b-pt-224"}, "directoryIdentitySha256": {"$ref": "#/$defs/sha256"}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["policyOrder", "numInferenceSteps", "noise"], "properties": {"policyOrder": {"const": ["base-pi05", "fine-tuned-pi05"]}, "numInferenceSteps": {"type": "integer", "minimum": 1}, "noise": {"type": "object", "additionalProperties": false, "required": ["seed", "shape", "dtype", "sha256", "generator"], "properties": {"seed": {"type": "integer", "minimum": 0}, "shape": {"const": [1, 50, 32]}, "dtype": {"const": "float32"}, "sha256": {"$ref": "#/$defs/sha256"}, "generator": {"$ref": "#/$defs/text"}}}}},
    "projection": {"type": "object", "additionalProperties": false, "required": ["available", "actionInterpretationId", "actionInterpretationVersion", "urdfSha256", "fkImplementationId", "calibratedArmTransforms", "calibratedGripperGeometry", "jointLimitPolicy", "jointLimitViolationCount"], "properties": {"available": {"type": "boolean"}, "actionInterpretationId": {"const": "pi05-postprocessed-absolute-position-targets"}, "actionInterpretationVersion": {"const": "1.0"}, "urdfSha256": {"$ref": "#/$defs/sha256"}, "fkImplementationId": {"$ref": "#/$defs/text"}, "calibratedArmTransforms": {"type": "boolean"}, "calibratedGripperGeometry": {"const": false}, "jointLimitPolicy": {"enum": ["reject", "allow-with-recorded-violations"]}, "jointLimitViolationCount": {"type": "integer", "minimum": 0}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "manifest", "plans"], "properties": {"schemaVersion": {"const": "1.1"}, "manifest": {"$ref": "#/$defs/fileDigest"}, "plans": {"$ref": "#/$defs/fileDigest"}}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fileDigest": {"type": "object", "additionalProperties": false, "required": ["byteCount", "sha256"], "properties": {"byteCount": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
